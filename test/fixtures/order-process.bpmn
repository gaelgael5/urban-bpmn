<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_order"
                  targetNamespace="http://urban-bpmn.example/processes">
  <bpmn:process id="Process_order" name="Traitement d'une commande" isExecutable="false">
    <bpmn:startEvent id="StartEvent_received" name="Commande reçue">
      <bpmn:outgoing>Flow_review</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_review" name="Vérifier la commande">
      <bpmn:incoming>Flow_review</bpmn:incoming>
      <bpmn:outgoing>Flow_decide</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_valid" name="Commande valide ?">
      <bpmn:incoming>Flow_decide</bpmn:incoming>
      <bpmn:outgoing>Flow_ship</bpmn:outgoing>
      <bpmn:outgoing>Flow_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ship" name="Expédier la commande">
      <bpmn:incoming>Flow_ship</bpmn:incoming>
      <bpmn:outgoing>Flow_done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_shipped" name="Commande expédiée">
      <bpmn:incoming>Flow_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_rejected" name="Commande rejetée">
      <bpmn:incoming>Flow_reject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_review" sourceRef="StartEvent_received" targetRef="Task_review" />
    <bpmn:sequenceFlow id="Flow_decide" sourceRef="Task_review" targetRef="Gateway_valid" />
    <bpmn:sequenceFlow id="Flow_ship" name="oui" sourceRef="Gateway_valid" targetRef="Task_ship" />
    <bpmn:sequenceFlow id="Flow_done" sourceRef="Task_ship" targetRef="EndEvent_shipped" />
    <bpmn:sequenceFlow id="Flow_reject" name="non" sourceRef="Gateway_valid" targetRef="EndEvent_rejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_order">
    <bpmndi:BPMNPlane id="BPMNPlane_order" bpmnElement="Process_order">
      <bpmndi:BPMNShape id="StartEvent_received_di" bpmnElement="StartEvent_received">
        <dc:Bounds x="179" y="159" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="155" y="202" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_review_di" bpmnElement="Task_review">
        <dc:Bounds x="270" y="137" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_valid_di" bpmnElement="Gateway_valid" isMarkerVisible="true">
        <dc:Bounds x="425" y="152" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="403" y="122" width="94" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ship_di" bpmnElement="Task_ship">
        <dc:Bounds x="530" y="137" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_shipped_di" bpmnElement="EndEvent_shipped">
        <dc:Bounds x="692" y="159" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="659" y="202" width="102" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_rejected_di" bpmnElement="EndEvent_rejected">
        <dc:Bounds x="432" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="405" y="325" width="91" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_review_di" bpmnElement="Flow_review">
        <di:waypoint x="215" y="177" />
        <di:waypoint x="270" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_decide_di" bpmnElement="Flow_decide">
        <di:waypoint x="370" y="177" />
        <di:waypoint x="425" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ship_di" bpmnElement="Flow_ship">
        <di:waypoint x="475" y="177" />
        <di:waypoint x="530" y="177" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="494" y="159" width="17" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_done_di" bpmnElement="Flow_done">
        <di:waypoint x="630" y="177" />
        <di:waypoint x="692" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_reject_di" bpmnElement="Flow_reject">
        <di:waypoint x="450" y="202" />
        <di:waypoint x="450" y="282" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="456" y="230" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
