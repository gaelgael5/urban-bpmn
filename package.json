{
  "name": "urban-bpmn",
  "version": "0.1.0",
  "description": "BPMN 2.0 process editor web component built on bpmn-js (bpmn.io).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaelgael5/urban-bpmn"
  },
  "keywords": [
    "bpmn",
    "bpmn-js",
    "diagram",
    "modeler",
    "web-component"
  ],
  "files": [
    "dist"
  ],
  "module": "dist/urban-bpmn.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && tsc -p tsconfig.build.json",
    "all": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "bpmn-js": "^18.33.1",
    "bpmn-moddle": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitest/browser-playwright": "^5.1.2",
    "eslint": "^10.15.0",
    "globals": "^16.0.0",
    "playwright": "^1.65.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
